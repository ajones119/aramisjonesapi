NODE_ENV=development
PORT=4322
HOST=0.0.0.0
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:4321,https://aramisjones.com,https://www.aramisjones.com
# Required in production; generate a private random value (e.g. openssl rand -hex 32).
# PLACE_COOKIE_SECRET=
PLACE_COOLDOWN_SECONDS=600
PLACE_NETWORK_CAP=4
# Optional; admin routes (list Placements, revert) exist only when set. At least 16 characters.
# PLACE_ADMIN_TOKEN=
# Where the Canvas and Placement History are saved (git-ignored by default).
PLACE_DATA_DIR=data/place
TYPESAFE_API_KEY=replace_with_your_typesafe_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_your_supabase_publishable_key

# When set, Place saves to Supabase instead of PLACE_DATA_DIR. Server-only; never expose in the browser.
# SUPABASE_SECRET_KEY=
